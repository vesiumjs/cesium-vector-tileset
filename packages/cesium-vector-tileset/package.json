{
  "name": "cesium-vector-tileset",
  "type": "module",
  "version": "1.0.0",
  "description": "Render vector tiles in Cesium with MapLibre styles",
  "license": "MIT",
  "homepage": "https://github.com/vesiumjs/cesium-vector-tileset#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vesiumjs/cesium-vector-tileset.git",
    "directory": "packages/cesium-vector-tileset"
  },
  "bugs": {
    "url": "https://github.com/vesiumjs/cesium-vector-tileset/issues"
  },
  "exports": {
    ".": "./index.ts",
    "./min": "./index.ts",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "peerDependencies": {
    "cesium": "^1.146.0"
  },
  "dependencies": {
    "@mapbox/point-geometry": "^1.1.0",
    "@mapbox/tiny-sdf": "^2.2.0",
    "@mapbox/vector-tile": "^3.0.0",
    "@maplibre/geojson-vt": "^6.1.2",
    "@maplibre/maplibre-gl-style-spec": "^26.4.4",
    "@maplibre/vt-pbf": "^4.3.2",
    "@types/geojson": "^7946.0.16",
    "earcut": "^3.2.4",
    "gl-matrix": "^3.4.4",
    "murmurhash-js": "^1.0.0",
    "pbf": "^5.1.2",
    "potpack": "^2.1.0",
    "tinyqueue": "^3.0.0"
  },
  "devDependencies": {
    "@maplibre/mlt": "^1.3.0",
    "@types/murmurhash-js": "^1.0.7",
    "@unicode/unicode-17.0.0": "^2.0.7",
    "cesium": "^1.146.0",
    "regenerate": "^1.5.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./min": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.min.mjs"
      },
      "./package.json": "./package.json"
    }
  }
}

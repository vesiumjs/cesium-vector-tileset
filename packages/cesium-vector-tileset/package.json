{
  "name": "cesium-vector-tileset",
  "type": "module",
  "version": "0.0.1",
  "description": "Render Mapbox Vector Tiles in Cesium",
  "license": "MIT",
  "exports": {
    ".": "./index.ts",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsdown --config ../../tsdown.config.ts",
    "codegen": "tsx build/generate-style-code.ts && tsx build/generate-struct-arrays.ts",
    "generate-unicode-data": "tsx build/generate-unicode-data.ts"
  },
  "dependencies": {
    "@mapbox/point-geometry": "^1.1.0",
    "@mapbox/tiny-sdf": "^2.2.0",
    "@mapbox/vector-tile": "^3.0.0",
    "@maplibre/geojson-vt": "^6.1.1",
    "@maplibre/maplibre-gl-style-spec": "^26.4.2",
    "@maplibre/vt-pbf": "^4.3.2",
    "@types/geojson": "^7946.0.16",
    "earcut": "^3.2.3",
    "gl-matrix": "^3.4.4",
    "murmurhash-js": "^1.0.0",
    "pbf": "^5.1.2",
    "potpack": "^2.1.0",
    "tinyqueue": "^3.0.0"
  },
  "devDependencies": {
    "@maplibre/mlt": "^1.3.0",
    "@types/murmurhash-js": "^1.0.7",
    "@unicode/unicode-17.0.0": "^2.0.7",
    "cesium": "^1.146.0",
    "regenerate": "^1.4.2",
    "tsx": "^4.23.13"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    }
  }
}

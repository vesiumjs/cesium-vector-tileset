{
  "version": 8,
  "name": "OSM US · 简洁矢量地图",
  "metadata": {
    "description": "Project-maintained OpenMapTiles vector cartography; intentionally independent of provider full styles."
  },
  "glyphs": "https://tiles.openstreetmap.us/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "basemap": {
      "type": "vector",
      "url": "https://tiles.openstreetmap.us/vector/openmaptiles.json",
      "attribution": "Tiles by OSM US · © OpenMapTiles · © OpenStreetMap contributors"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f2f1ed"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "basemap",
      "source-layer": "landcover",
      "paint": {
        "fill-color": "#dce8d4"
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "basemap",
      "source-layer": "landuse",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "class"
          ],
          [
            "residential",
            "suburb",
            "neighbourhood"
          ],
          "#e8e4de",
          [
            "industrial",
            "commercial"
          ],
          "#e2ddd6",
          "#dce8d4"
        ]
      }
    },
    {
      "id": "parks",
      "type": "fill",
      "source": "basemap",
      "source-layer": "park",
      "paint": {
        "fill-color": "#cddfc6"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "basemap",
      "source-layer": "water",
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "Polygon"
      ],
      "paint": {
        "fill-color": "#add3df"
      }
    },
    {
      "id": "waterways",
      "type": "line",
      "source": "basemap",
      "source-layer": "waterway",
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "LineString"
      ],
      "paint": {
        "line-color": "#9cc7d6",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          0.6,
          16,
          3
        ]
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "basemap",
      "source-layer": "transportation",
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "LineString"
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": [
          "match",
          [
            "get",
            "class"
          ],
          [
            "motorway",
            "trunk"
          ],
          "#dfb172",
          [
            "primary",
            "secondary"
          ],
          "#e9c999",
          "#ffffff"
        ],
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.4
          ],
          [
            "zoom"
          ],
          5,
          0.5,
          12,
          1.5,
          17,
          7
        ]
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "basemap",
      "source-layer": "building",
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "Polygon"
      ],
      "minzoom": 13,
      "paint": {
        "fill-color": "#d5cec4",
        "fill-outline-color": "#b7aea2"
      }
    },
    {
      "id": "boundaries",
      "type": "line",
      "source": "basemap",
      "source-layer": "boundary",
      "filter": [
        "all",
        [
          "==",
          [
            "geometry-type"
          ],
          "LineString"
        ],
        [
          "<=",
          [
            "get",
            "admin_level"
          ],
          4
        ]
      ],
      "paint": {
        "line-color": "#9091a0",
        "line-width": 1,
        "line-dasharray": [
          3,
          2
        ]
      }
    },
    {
      "id": "places",
      "type": "symbol",
      "source": "basemap",
      "source-layer": "place",
      "filter": [
        "<",
        [
          "get",
          "rank"
        ],
        8
      ],
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          3,
          10,
          12,
          14
        ],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#34424e",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    }
  ]
}

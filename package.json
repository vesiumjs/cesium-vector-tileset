{
  "name": "cesium-vector-tileset-lib",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "license": "MIT",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:ci": "tsdown",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build:ci && pnpm build && playwright test",
    "test:e2e:live": "E2E_LIVE=1 playwright test",
    "test:e2e:install": "playwright install chromium",
    "lint": "pnpm lint:eslint && pnpm lint:tsc",
    "lint:eslint": "eslint . --fix",
    "lint:tsc": "vue-tsc --build --force",
    "taze": "taze",
    "release": "bumpp -r",
    "publish:ci": "tsx ./scripts/publish",
    "codegen": "tsx packages/cesium-vector-tileset/build/generate-style-code.ts && tsx packages/cesium-vector-tileset/build/generate-struct-arrays.ts",
    "generate-unicode-data": "tsx packages/cesium-vector-tileset/build/generate-unicode-data.ts"
  },
  "dependencies": {
    "cesium": "^1.146.0",
    "cesium-vector-tileset": "workspace:*",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@mapbox/point-geometry": "1.1.0",
    "@maplibre/geojson-vt": "^6.1.2",
    "@maplibre/maplibre-gl-style-spec": "^26.4.4",
    "@maplibre/vt-pbf": "^4.3.2",
    "@types/earcut": "^3.0.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/tsconfig": "^0.9.1",
    "bumpp": "^12.3.0",
    "canvas": "^3.2.3",
    "eslint": "^10.12.0",
    "eslint-plugin-format": "^2.0.1",
    "jsdom": "^30.1.2",
    "maplibre-gl": "6.12.0",
    "nise": "^6.1.5",
    "playwright": "1.63.0",
    "rolldown": "~1.2.12",
    "taze": "^21.3.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "unplugin-cesium": "^3.1.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vitest-webgl-canvas-mock": "^1.1.0",
    "vue-tsc": "^3.3.12"
  }
}
